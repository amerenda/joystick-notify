[Unit]
Description=Detect controllers whose receiver generates no udev event on power on/off
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/usr/bin/python3 /usr/local/bin/controller-liveness-watch.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
