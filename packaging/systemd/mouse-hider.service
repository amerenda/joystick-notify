[Unit]
Description=Hide the mouse cursor when idle (couch mode)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# READY=1 only once the pointer is hidden, so `systemctl start` (the couch
# prestart hook) returns before the launch.
Type=notify
NotifyAccess=main
TimeoutStartSec=20
# 1 (default): the pointer never reappears, mouse devices are grabbed. 0: hide
# after [mouse_hider] idle_seconds of inactivity and show again on motion.
Environment=MOUSE_HIDER_ALWAYS_HIDDEN=1
ExecStart=/usr/bin/mouse-hider run
# Whatever ends the hider (stop, crash, kill, logout), the cursor comes back.
ExecStopPost=/usr/bin/mouse-hider restore
Restart=on-failure
RestartSec=2
# Not [Install]ed on purpose: joystick-notify's hooks start/stop it per couch session.
