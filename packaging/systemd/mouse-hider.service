[Unit]
Description=Hide the mouse cursor when idle (couch mode)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/mouse-hider run
# Whatever ends the hider (stop, crash, kill, logout), the cursor comes back.
ExecStopPost=/usr/bin/mouse-hider restore
Restart=on-failure
RestartSec=2
# Not [Install]ed on purpose: joystick-notify's hooks start/stop it per couch session.
