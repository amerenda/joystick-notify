[Unit]
Description=joystick-notify daemon (controller-triggered couch/desk automation)
After=graphical-session.target
PartOf=graphical-session.target
Wants=joystick-notify-tray.service

[Service]
Type=simple
ExecStart=/usr/bin/jn-daemon
# Leading "-" tells systemd to ignore a nonzero exit here: --doctor's
# report lands in the journal as a pre-flight log entry, but a failing
# check (e.g. no CEC adapter, not yet configured) must not block the
# service from starting — both are valid states per
# plans/joystick-notify-v2.md. The running daemon's own Health registry
# (tray/wizard) carries live status from here on.
ExecStartPre=-/usr/bin/jn-daemon --doctor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
