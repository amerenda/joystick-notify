#!/usr/bin/env python3
"""mouse-hider: hide the pointer after N seconds of inactivity, restore on motion.

Standalone. Not part of the joystick-notify daemon or wizard: point the
wizard's launch/teardown commands at `mouse-hider start` / `mouse-hider stop`.

How it hides: KWin's built-in "hidecursor" effect (KWin 6.2+), loaded at
runtime over D-Bus while the hider runs and unloaded when it stops. KWin
itself hides the pointer after the idle timeout and shows it on the next
pointer event, over every window.

Hide on start: the effect has no "hide now" call, so it is loaded with its
shortest timeout (1s) and the pointer disappears right after start. The
first real pointer event (read from evdev, read-only) switches it to
idle_seconds. That switch has to wait for motion because the effect's
reconfigure always shows the pointer; right after motion it's visible anyway. An earlier version swapped the cursor
THEME instead; KWin reported the swap as live, but Wayland clients that set
their own cursor surface (browsers, terminals, most apps) kept drawing a
visible pointer, so the cursor never actually disappeared over windows.

Safety properties (the whole point of this script):
  * The effect is loaded at runtime only (Effects.loadEffect), never enabled
    in kwinrc's [Plugins], so a crash, logout or reboot can't leave it on.
  * `run` checks the effect every few seconds and loads it again if KWin
    dropped it (KWin restart), so the hider never silently stops working.
  * `stop` / SIGTERM / SIGINT / any crash unload the effect.
  * `restore` unloads the effect and cures a transparent cursor theme left
    over from the old theme-swapping version; it works whether or not the
    hider runs.

Always hidden (default): the hidecursor effect alone shows the pointer again on
every motion, so with MOUSE_HIDER_ALWAYS_HIDDEN on (the default; set it to 0 in
the systemd unit to go back to hide-on-idle) the hider also takes an exclusive
evdev grab of every mouse-like input device, so no pointer motion ever reaches
the compositor and the pointer never comes back while the hider runs. The grabs
go with the process (stop, crash, kill). Not grabbed: Sunshine's virtual mouse
(libvirtualhid, remote streaming input) and anything with gamepad buttons.

Config: no settings of its own. The idle timeout is [mouse_hider] idle_seconds
in joystick-notify's config.toml (~/.config/joystick-notify/), set from the
wizard; 15 when that is absent.
"""
from __future__ import annotations

import argparse
import os
import re
import select
import signal
import subprocess
import sys
import threading
import time
import tomllib
from dataclasses import dataclass
from pathlib import Path

DEFAULT_IDLE_SECONDS = 15.0
NORMAL_THEME = "breeze_cursors"  # what `restore` puts back if the old transparent theme is live
HOLD_SECONDS = 30.0  # keep the 1s hide-now timeout this long after start, motion or not
EFFECT = "hidecursor"
FORCE_EFFECT = "jn_hidecursor"  # tools/kwin-hidecursor: hides while loaded, no timer, no input watching
EFFECT_GROUP = "Effect-hidecursor"
HIDDEN_THEME = "invisible"  # the old version's transparent theme (ansible-playbooks roles/mouse-hide)
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "joystick-notify" / "config.toml"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PIDFILE = RUNTIME_DIR / "mouse-hider.pid"
CHECK_S = 5.0
HIDE_NOW_S = 1  # the effect's shortest timeout: 0 means never
SETTLE_S = HIDE_NOW_S + 1.0  # the pointer is gone this long after the effect loads
# evdev types/codes counted as pointer activity, the same events KWin's
# effect treats as activity. Keyboard keys (a CEC remote) are not.
EV_KEY, EV_REL, EV_ABS = 0x01, 0x02, 0x03
BTN_MOUSE, BTN_JOYSTICK = 0x110, 0x120
CMD_TIMEOUT_S = 8.0


def env_flag(name: str, default: bool, environ: dict[str, str] | None = None) -> bool:
    raw = (os.environ if environ is None else environ).get(name, "").strip().lower()
    if not raw:
        return default
    return raw not in ("0", "false", "no", "off")


@dataclass
class Config:
    always_hidden: bool = True  # MOUSE_HIDER_ALWAYS_HIDDEN, set in the systemd unit
    idle_seconds: float = DEFAULT_IDLE_SECONDS
    normal_theme: str = NORMAL_THEME
    hold_seconds: float = HOLD_SECONDS

    @property
    def inactivity_duration(self) -> int:
        """KWin's InactivityDuration is whole seconds, and 0 means never."""
        return max(1, round(self.idle_seconds))


def load_config(path: Path = CONFIG_PATH) -> Config:
    idle = DEFAULT_IDLE_SECONDS
    if path.exists():
        with path.open("rb") as f:
            idle = tomllib.load(f).get("mouse_hider", {}).get("idle_seconds", idle)
    cfg = Config(always_hidden=env_flag("MOUSE_HIDER_ALWAYS_HIDDEN", True), idle_seconds=float(idle))
    if cfg.idle_seconds <= 0:
        raise SystemExit("mouse_hider idle_seconds must be > 0")
    return cfg


# --- KWin plumbing -----------------------------------------------------------

def session_env(base: dict[str, str] | None = None) -> dict[str, str]:
    """Environment for talking to the user's KWin session.

    Callers differ (daemon child, systemd user unit, plain ssh): without
    WAYLAND_DISPLAY, Qt tools like plasma-apply-cursortheme abort silently.
    """
    env = dict(os.environ if base is None else base)
    runtime = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus")
    if "WAYLAND_DISPLAY" not in env:
        socks = sorted(p.name for p in Path(runtime).glob("wayland-[0-9]*") if not p.name.endswith(".lock"))
        env["WAYLAND_DISPLAY"] = socks[0] if socks else "wayland-0"
    env.setdefault("QT_QPA_PLATFORM", "wayland")
    return env


def _run(cmd: list[str]) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=CMD_TIMEOUT_S, env=session_env())
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return -1, str(e)
    return p.returncode, p.stdout + p.stderr


def _effects(method: str, *args: str) -> tuple[int, str]:
    return _run(["qdbus6", "org.kde.KWin", "/Effects", f"org.kde.kwin.Effects.{method}", *args])


def effect_loaded(name: str = EFFECT) -> bool | None:
    """None when KWin can't be asked at all."""
    rc, out = _effects("isEffectLoaded", name)
    if rc != 0:
        return None
    return out.strip().lower() == "true"


def configure_effect(cfg: Config, duration: int | None = None) -> None:
    duration = cfg.inactivity_duration if duration is None else duration
    for key, value in (("InactivityDuration", str(duration)), ("HideOnTyping", "false")):
        _run(["kwriteconfig6", "--file", "kwinrc", "--group", EFFECT_GROUP, "--key", key, value])


def enable_hiding(cfg: Config, duration: int | None = None) -> bool:
    """Load the effect with `duration` (default idle_seconds) and VERIFY it's loaded.

    reconfigureEffect runs even right after loadEffect: only it makes KWin
    reparse kwinrc, so a fresh load alone can keep a stale cached timeout.
    """
    configure_effect(cfg, duration)
    if not effect_loaded():
        _effects("loadEffect", EFFECT)
    _effects("reconfigureEffect", EFFECT)
    return effect_loaded() is True


def enable_forced_hiding() -> bool:
    """Load jn_hidecursor and VERIFY. False when the plugin is not installed or KWin refuses it."""
    if effect_loaded(FORCE_EFFECT):
        return True
    _effects("loadEffect", FORCE_EFFECT)
    return effect_loaded(FORCE_EFFECT) is True


def disable_hiding() -> bool:
    """Unload the effects (KWin shows the pointer again) and VERIFY."""
    for name in (FORCE_EFFECT, EFFECT):
        if effect_loaded(name) is not False:
            _effects("unloadEffect", name)
    return effect_loaded(FORCE_EFFECT) is not True and effect_loaded() is False


def live_theme() -> str | None:
    rc, out = _run(["qdbus6", "org.kde.KWin", "/KWin", "supportInformation"])
    if rc != 0:
        return None
    section = out.partition("\nCursor\n")[2]
    m = re.search(r"^themeName:\s*(\S+)\s*$", section, re.MULTILINE)
    return m.group(1) if m else None


def cure_hidden_theme(cfg: Config) -> bool:
    """Put the normal theme back if the old version's transparent one is live."""
    if live_theme() != HIDDEN_THEME:
        return True
    _run(["plasma-apply-cursortheme", cfg.normal_theme])
    return live_theme() == cfg.normal_theme


def make_visible(cfg: Config) -> bool:
    unloaded = disable_hiding()
    cured = cure_hidden_theme(cfg)
    return unloaded and cured


def log(msg: str) -> None:
    print(f"mouse-hider: {msg}", flush=True)


def is_pointer_activity(ev_type: int, code: int) -> bool:
    if ev_type in (EV_REL, EV_ABS):
        return True
    return ev_type == EV_KEY and BTN_MOUSE <= code < BTN_JOYSTICK


def pointer_devices() -> list:
    try:
        import evdev
    except ImportError:
        return []
    found = []
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        caps = dev.capabilities()
        if evdev.ecodes.REL_X in caps.get(EV_REL, []) or BTN_MOUSE in caps.get(EV_KEY, []):
            found.append(dev)
        else:
            dev.close()
    return found


BTN_GAMEPAD, BTN_THUMBR = 0x130, 0x13F
UNGRABBED_NAMES = ("libvirtualhid",)  # Sunshine's remote-input devices


def should_grab(name: str, key_codes, has_rel_x: bool) -> bool:
    """A mouse-like device that is not Sunshine's virtual input and not a gamepad."""
    if not (has_rel_x or BTN_MOUSE in key_codes):
        return False
    if name.startswith(UNGRABBED_NAMES):
        return False
    return not any(BTN_GAMEPAD <= code <= BTN_THUMBR for code in key_codes)


class PointerGrabber:
    """Exclusive evdev grabs on mouse-like devices, so the pointer never moves.

    Devices another process already grabbed (keyd takes the physical ones) fail
    with EBUSY and are skipped; the next scan retries them.
    """

    def __init__(self) -> None:
        self.grabbed: dict[str, object] = {}

    def scan(self) -> int:
        try:
            import evdev
        except ImportError:
            return 0
        for path in evdev.list_devices():
            if path in self.grabbed:
                continue
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            caps = dev.capabilities()
            if not should_grab(dev.name, caps.get(EV_KEY, []), evdev.ecodes.REL_X in caps.get(EV_REL, [])):
                dev.close()
                continue
            try:
                dev.grab()
            except OSError:
                dev.close()
                continue
            self.grabbed[path] = dev
            log(f"grabbed {dev.name!r} ({path})")
        for path, dev in list(self.grabbed.items()):
            if not os.path.exists(path):  # unplugged
                self._drop(path)
        return len(self.grabbed)

    def _drop(self, path: str) -> None:
        dev = self.grabbed.pop(path)
        try:
            dev.ungrab()
        except OSError:
            pass
        dev.close()

    def release(self) -> None:
        for path in list(self.grabbed):
            self._drop(path)


def wait_for_pointer_activity(timeout: float) -> bool:
    """True as soon as any pointer device reports activity within `timeout`."""
    devices = pointer_devices()
    deadline = time.monotonic() + timeout
    try:
        while devices and (left := deadline - time.monotonic()) > 0:
            ready, _, _ = select.select(devices, [], [], min(left, 0.5))
            for dev in ready:
                try:
                    if any(is_pointer_activity(ev.type, ev.code) for ev in dev.read()):
                        return True
                except OSError:
                    devices.remove(dev)  # unplugged
        if not devices:
            time.sleep(max(0.0, deadline - time.monotonic()))
        return False
    finally:
        for dev in devices:
            dev.close()


def notify_ready() -> None:
    """systemd Type=notify READY=1, so `systemctl start mouse-hider` returns only once hidden."""
    path = os.environ.get("NOTIFY_SOCKET")
    if not path:
        return
    import socket

    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
        sock.connect("\0" + path[1:] if path.startswith("@") else path)
        sock.sendall(b"READY=1")


def run_loop_always_hidden(cfg: Config, stop: threading.Event) -> None:
    """Pointer gone for good: jn_hidecursor loaded and every pointer device grabbed.

    Without the jn_hidecursor plugin this falls back to the stock effect on its
    1s timeout, which flashes the pointer whenever KWin itself moves it (a game
    releasing its pointer lock), but is otherwise hidden.
    """
    grabber = PointerGrabber()
    forced = enable_forced_hiding()
    hidden = forced or enable_hiding(cfg, HIDE_NOW_S)
    n = grabber.scan()
    if hidden:
        mode = FORCE_EFFECT if forced else f"{EFFECT} (FALLBACK, {FORCE_EFFECT} unavailable: pointer flashes when KWin warps it)"
        log(f"KWin {mode} loaded, {n} pointer device(s) grabbed: pointer stays hidden")
        time.sleep(SETTLE_S)
        notify_ready()
        log("pointer hidden, ready")
    else:
        log("FAILED to load a KWin hide effect, will retry")
    try:
        while not stop.wait(CHECK_S):
            grabber.scan()  # hotplugged mice
            if forced and effect_loaded(FORCE_EFFECT) is True:
                continue
            forced = enable_forced_hiding()
            if not forced and effect_loaded() is not True:
                ok = enable_hiding(cfg, HIDE_NOW_S)
                log("hide effect was not loaded: " + ("loaded again" if ok else "FAILED to load, will retry"))
    finally:
        grabber.release()
        make_visible(cfg)
        log("stopped, cursor restored")


def run_loop(cfg: Config, stop: threading.Event) -> None:
    if cfg.always_hidden:
        return run_loop_always_hidden(cfg, stop)
    # Hide on start: the shortest timeout first, idle_seconds after the first
    # motion once the hold has passed (the hider is started BEFORE the launch
    # and must keep the pointer hidden until the launched app is up).
    hide_now = enable_hiding(cfg, HIDE_NOW_S)
    hold_until = time.monotonic() + cfg.hold_seconds
    if hide_now:
        log(f"KWin {EFFECT} effect loaded: pointer hides now, then after {cfg.inactivity_duration}s idle")
        time.sleep(SETTLE_S)
        notify_ready()
        log("pointer hidden, ready")
    else:
        log(f"FAILED to load KWin {EFFECT} effect, will retry")
    try:
        while not stop.is_set():
            if hide_now:
                if wait_for_pointer_activity(CHECK_S) and not stop.is_set():
                    if time.monotonic() < hold_until:
                        stop.wait(min(CHECK_S, hold_until - time.monotonic()))
                        continue
                    hide_now = False
                    configure_effect(cfg)
                    _effects("reconfigureEffect", EFFECT)
                    log(f"pointer activity: idle timeout now {cfg.inactivity_duration}s")
                    continue
            elif stop.wait(CHECK_S):
                break
            if effect_loaded() is not True:
                hide_now = False
                ok = enable_hiding(cfg)
                log(f"{EFFECT} effect was not loaded: " + ("loaded again" if ok else "FAILED to load, will retry"))
    finally:
        make_visible(cfg)
        log("stopped, cursor restored")


# --- commands ---------------------------------------------------------------

def read_pid() -> int | None:
    try:
        pid = int(PIDFILE.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return None


def cmd_run(args: argparse.Namespace) -> int:
    cfg = load_config()
    if not cure_hidden_theme(cfg):
        log(f"WARNING: could not confirm {cfg.normal_theme!r} is live before starting")
    stop = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())
    PIDFILE.write_text(str(os.getpid()))
    try:
        run_loop(cfg, stop)
    finally:
        PIDFILE.unlink(missing_ok=True)
    return 0


def cmd_start(args: argparse.Namespace) -> int:
    if read_pid():
        log(f"already running (pid {read_pid()})")
        return 0
    cmd = [sys.executable, os.path.abspath(__file__), "run"]
    logf = open(RUNTIME_DIR / "mouse-hider.log", "ab")
    p = subprocess.Popen(cmd, stdout=logf, stderr=logf, stdin=subprocess.DEVNULL, start_new_session=True)
    log(f"started (pid {p.pid})")
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    """Kill the hider and make the pointer visible and working."""
    pid = read_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(40):
            if read_pid() is None:
                break
            time.sleep(0.25)
        else:
            os.kill(pid, signal.SIGKILL)
    return cmd_restore(args)


def cmd_restore(args: argparse.Namespace) -> int:
    cfg = load_config()
    if make_visible(cfg):
        log(f"cursor visible ({EFFECT} effect unloaded)")
        return 0
    log(f"ERROR: {EFFECT} effect loaded={effect_loaded()}, live cursor theme {live_theme()!r}")
    return 1


def cmd_status(args: argparse.Namespace) -> int:
    pid = read_pid()
    print(f"hider: {'running pid ' + str(pid) if pid else 'not running'}")
    print(f"{EFFECT} effect loaded: {effect_loaded()}")
    print(f"live cursor theme: {live_theme()}")
    return 0 if pid else 3


def main() -> int:
    ap = argparse.ArgumentParser(prog="mouse-hider", description=__doc__.split("\n\n")[0])
    ap.add_argument("command", choices=["start", "stop", "restore", "status", "run"])
    args = ap.parse_args()
    return {"start": cmd_start, "stop": cmd_stop, "restore": cmd_restore, "status": cmd_status, "run": cmd_run}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
