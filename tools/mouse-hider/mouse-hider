#!/usr/bin/env python3
"""mouse-hider: hide the pointer after N seconds of inactivity, restore on motion.

Standalone. Not part of the joystick-notify daemon or wizard: point the
wizard's launch/teardown commands at `mouse-hider start` / `mouse-hider stop`.

How it hides: KWin's built-in "hidecursor" effect (KWin 6.2+), loaded at
runtime over D-Bus while the hider runs and unloaded when it stops. KWin
itself hides the pointer after the idle timeout and shows it on the next
pointer event, over every window.

Hide on start: the effect has no "hide now" call, so it is loaded with its
shortest timeout (1s) and the pointer disappears right after start. The
first real pointer event (read from evdev, read-only) switches it to
idle_seconds. That switch has to wait for motion because the effect's
reconfigure always shows the pointer; right after motion it's visible anyway. An earlier version swapped the cursor
THEME instead; KWin reported the swap as live, but Wayland clients that set
their own cursor surface (browsers, terminals, most apps) kept drawing a
visible pointer, so the cursor never actually disappeared over windows.

Safety properties (the whole point of this script):
  * The effect is loaded at runtime only (Effects.loadEffect), never enabled
    in kwinrc's [Plugins], so a crash, logout or reboot can't leave it on.
  * `run` checks the effect every few seconds and loads it again if KWin
    dropped it (KWin restart), so the hider never silently stops working.
  * `stop` / SIGTERM / SIGINT / any crash unload the effect.
  * `restore` unloads the effect and cures a transparent cursor theme left
    over from the old theme-swapping version; it works whether or not the
    hider runs.

Opt-in (grab_controllers = true): controller input must not reveal the pointer. A gamepad dongle also exposes
keyboard/mouse evdev nodes (the Steam Controller Puck's "lizard mode", an
8BitDo dongle's HID mouse) and KWin shows the pointer on any pointer event from
any device, so pressing d-pad-up on the controller brought it back. While the
hider runs it takes an exclusive grab (EVIOCGRAB) on those nodes, so KWin never
sees them: only vendor-matched keyboard/mouse nodes without gamepad buttons,
never the gamepad node a game reads. Off by default because it also takes the
controller's lizard-mode desktop control away while Steam is not running. The kernel drops a grab when the hider's
fd closes, so stop, crash or kill releases the controller too.

Config: ~/.config/mouse-hider/config.toml (all keys optional)
    idle_seconds = 15
    normal_theme = "breeze_cursors"   # what `restore` puts back if a hidden theme is live
    grab_controllers = false          # opt in: keep controller keyboard/mouse nodes away from KWin
    controller_vendors = ["28de", "2dc8"]   # Valve, 8BitDo
CLI flag --idle overrides the file. `mouse-hider probe [seconds]` prints which
device produces pointer-class events, to find what reveals the pointer.
"""
from __future__ import annotations

import argparse
import os
import re
import select
import signal
import subprocess
import sys
import threading
import time
import tomllib
from dataclasses import dataclass
from pathlib import Path

DEFAULTS = {
    "idle_seconds": 15.0,
    "normal_theme": "breeze_cursors",
    "grab_controllers": False,
    "controller_vendors": ["28de", "2dc8"],
}
EFFECT = "hidecursor"
EFFECT_GROUP = "Effect-hidecursor"
HIDDEN_THEME = "invisible"  # the old version's transparent theme (ansible-playbooks roles/mouse-hide)
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "mouse-hider" / "config.toml"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PIDFILE = RUNTIME_DIR / "mouse-hider.pid"
CHECK_S = 5.0
HIDE_NOW_S = 1  # the effect's shortest timeout: 0 means never
# evdev types/codes counted as pointer activity, the same events KWin's
# effect treats as activity. Keyboard keys (a CEC remote) are not.
EV_KEY, EV_REL, EV_ABS = 0x01, 0x02, 0x03
BTN_MOUSE, BTN_JOYSTICK = 0x110, 0x120
BTN_GAMEPAD = 0x130  # BTN_SOUTH: only gamepad nodes have it
CMD_TIMEOUT_S = 8.0


@dataclass
class Config:
    idle_seconds: float = 15.0
    normal_theme: str = "breeze_cursors"
    grab_controllers: bool = False
    controller_vendors: tuple[int, ...] = (0x28DE, 0x2DC8)

    @property
    def inactivity_duration(self) -> int:
        """KWin's InactivityDuration is whole seconds, and 0 means never."""
        return max(1, round(self.idle_seconds))


def load_config(args: argparse.Namespace, path: Path = CONFIG_PATH) -> Config:
    raw = dict(DEFAULTS)
    if path.exists():
        with path.open("rb") as f:
            raw.update({k: v for k, v in tomllib.load(f).items() if k in DEFAULTS})
    if getattr(args, "idle", None) is not None:
        raw["idle_seconds"] = args.idle
    cfg = Config(
        idle_seconds=float(raw["idle_seconds"]),
        normal_theme=str(raw["normal_theme"]),
        grab_controllers=bool(raw["grab_controllers"]),
        controller_vendors=tuple(int(str(v), 16) for v in raw["controller_vendors"]),
    )
    if cfg.idle_seconds <= 0:
        raise SystemExit("idle_seconds must be > 0")
    return cfg


# --- KWin plumbing -----------------------------------------------------------

def session_env(base: dict[str, str] | None = None) -> dict[str, str]:
    """Environment for talking to the user's KWin session.

    Callers differ (daemon child, systemd user unit, plain ssh): without
    WAYLAND_DISPLAY, Qt tools like plasma-apply-cursortheme abort silently.
    """
    env = dict(os.environ if base is None else base)
    runtime = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus")
    if "WAYLAND_DISPLAY" not in env:
        socks = sorted(p.name for p in Path(runtime).glob("wayland-[0-9]*") if not p.name.endswith(".lock"))
        env["WAYLAND_DISPLAY"] = socks[0] if socks else "wayland-0"
    env.setdefault("QT_QPA_PLATFORM", "wayland")
    return env


def _run(cmd: list[str]) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=CMD_TIMEOUT_S, env=session_env())
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return -1, str(e)
    return p.returncode, p.stdout + p.stderr


def _effects(method: str, *args: str) -> tuple[int, str]:
    return _run(["qdbus6", "org.kde.KWin", "/Effects", f"org.kde.kwin.Effects.{method}", *args])


def effect_loaded() -> bool | None:
    """None when KWin can't be asked at all."""
    rc, out = _effects("isEffectLoaded", EFFECT)
    if rc != 0:
        return None
    return out.strip().lower() == "true"


def configure_effect(cfg: Config, duration: int | None = None) -> None:
    duration = cfg.inactivity_duration if duration is None else duration
    for key, value in (("InactivityDuration", str(duration)), ("HideOnTyping", "false")):
        _run(["kwriteconfig6", "--file", "kwinrc", "--group", EFFECT_GROUP, "--key", key, value])


def enable_hiding(cfg: Config, duration: int | None = None) -> bool:
    """Load the effect with `duration` (default idle_seconds) and VERIFY it's loaded.

    reconfigureEffect runs even right after loadEffect: only it makes KWin
    reparse kwinrc, so a fresh load alone can keep a stale cached timeout.
    """
    configure_effect(cfg, duration)
    if not effect_loaded():
        _effects("loadEffect", EFFECT)
    _effects("reconfigureEffect", EFFECT)
    return effect_loaded() is True


def disable_hiding() -> bool:
    """Unload the effect (KWin shows the pointer again) and VERIFY."""
    if effect_loaded() is False:
        return True
    _effects("unloadEffect", EFFECT)
    return effect_loaded() is False


def live_theme() -> str | None:
    rc, out = _run(["qdbus6", "org.kde.KWin", "/KWin", "supportInformation"])
    if rc != 0:
        return None
    section = out.partition("\nCursor\n")[2]
    m = re.search(r"^themeName:\s*(\S+)\s*$", section, re.MULTILINE)
    return m.group(1) if m else None


def cure_hidden_theme(cfg: Config) -> bool:
    """Put the normal theme back if the old version's transparent one is live."""
    if live_theme() != HIDDEN_THEME:
        return True
    _run(["plasma-apply-cursortheme", cfg.normal_theme])
    return live_theme() == cfg.normal_theme


def make_visible(cfg: Config) -> bool:
    unloaded = disable_hiding()
    cured = cure_hidden_theme(cfg)
    return unloaded and cured


def log(msg: str) -> None:
    print(f"mouse-hider: {msg}", flush=True)


def is_pointer_activity(ev_type: int, code: int) -> bool:
    if ev_type in (EV_REL, EV_ABS):
        return True
    return ev_type == EV_KEY and BTN_MOUSE <= code < BTN_JOYSTICK


def is_controller_input_node(vendor: int, caps: dict, vendors: tuple[int, ...]) -> bool:
    """A keyboard/mouse node of a gamepad dongle, not the gamepad itself.

    Vendor-matched, and without gamepad buttons: the node a game or Steam
    reads must stay untouched.
    """
    if vendor not in vendors:
        return False
    keys = caps.get(EV_KEY, [])
    if BTN_GAMEPAD in keys:
        return False
    return EV_REL in caps or BTN_MOUSE in keys or bool(keys)


def is_pointer_device(caps: dict) -> bool:
    import evdev

    return evdev.ecodes.REL_X in caps.get(EV_REL, []) or BTN_MOUSE in caps.get(EV_KEY, [])


def open_devices() -> list:
    try:
        import evdev
    except ImportError:
        return []
    found = []
    for path in evdev.list_devices():
        try:
            found.append(evdev.InputDevice(path))
        except OSError:
            continue
    return found


def pointer_devices(cfg: Config | None = None) -> list:
    """Devices whose events can move the pointer, minus the controllers we keep away from KWin."""
    found = []
    for dev in open_devices():
        caps = dev.capabilities()
        if cfg and cfg.grab_controllers and is_controller_input_node(dev.info.vendor, caps, cfg.controller_vendors):
            dev.close()
        elif is_pointer_device(caps):
            found.append(dev)
        else:
            dev.close()
    return found


class ControllerGrabs:
    """Exclusive grabs on controller keyboard/mouse nodes, kept in sync with hot-plug."""

    def __init__(self, cfg: Config, opener=None) -> None:
        self.cfg = cfg
        self._opener = opener or (lambda: open_devices())
        self.grabbed: dict[str, object] = {}  # path -> device

    def sync(self) -> list[str]:
        """Grab new matching nodes, drop grabs on vanished ones. Returns log lines."""
        notes = []
        if not self.cfg.grab_controllers:
            return notes
        seen = set()
        for dev in self._opener():
            seen.add(dev.path)
            if dev.path in self.grabbed:
                dev.close()
                continue
            if not is_controller_input_node(dev.info.vendor, dev.capabilities(), self.cfg.controller_vendors):
                dev.close()
                continue
            try:
                dev.grab()
            except OSError as e:
                notes.append(f"could not grab {dev.path} ({dev.name}): {e}")
                dev.close()
                continue
            self.grabbed[dev.path] = dev
            notes.append(f"grabbed {dev.path} ({dev.name}): controller input stays away from KWin")
        for path in [p for p in self.grabbed if p not in seen]:
            self._release(path)
            notes.append(f"{path} is gone")
        return notes

    def _release(self, path: str) -> None:
        dev = self.grabbed.pop(path, None)
        if dev is None:
            return
        try:
            dev.ungrab()
        except OSError:
            pass
        dev.close()

    def release_all(self) -> None:
        for path in list(self.grabbed):
            self._release(path)


def describe_event(dev, ev) -> str:
    import evdev

    return f"{dev.path} {dev.name!r} {evdev.ecodes.EV.get(ev.type)} {evdev.ecodes.bytype.get(ev.type, {}).get(ev.code, ev.code)}"


def wait_for_pointer_activity(timeout: float, cfg: Config | None = None) -> str | None:
    """Describe the first pointer event any device reports within `timeout`, else None."""
    devices = pointer_devices(cfg)
    deadline = time.monotonic() + timeout
    try:
        while devices and (left := deadline - time.monotonic()) > 0:
            ready, _, _ = select.select(devices, [], [], min(left, 0.5))
            for dev in ready:
                try:
                    for ev in dev.read():
                        if is_pointer_activity(ev.type, ev.code):
                            return describe_event(dev, ev)
                except OSError:
                    devices.remove(dev)  # unplugged
        if not devices:
            time.sleep(max(0.0, deadline - time.monotonic()))
        return None
    finally:
        for dev in devices:
            dev.close()


def run_loop(cfg: Config, stop: threading.Event) -> None:
    # Hide on start: the shortest timeout first, idle_seconds after the first motion.
    grabs = ControllerGrabs(cfg)
    for note in grabs.sync():
        log(note)
    hide_now = enable_hiding(cfg, HIDE_NOW_S)
    if hide_now:
        log(f"KWin {EFFECT} effect loaded: pointer hides now, then after {cfg.inactivity_duration}s idle")
    else:
        log(f"FAILED to load KWin {EFFECT} effect, will retry")
    try:
        while not stop.is_set():
            for note in grabs.sync():
                log(note)
            if hide_now:
                source = wait_for_pointer_activity(CHECK_S, cfg)
                if source and not stop.is_set():
                    hide_now = False
                    configure_effect(cfg)
                    _effects("reconfigureEffect", EFFECT)
                    log(f"pointer activity from {source}: idle timeout now {cfg.inactivity_duration}s")
                    continue
            elif stop.wait(CHECK_S):
                break
            if effect_loaded() is not True:
                hide_now = False
                ok = enable_hiding(cfg)
                log(f"{EFFECT} effect was not loaded: " + ("loaded again" if ok else "FAILED to load, will retry"))
    finally:
        grabs.release_all()
        make_visible(cfg)
        log("stopped, cursor restored")


# --- commands ---------------------------------------------------------------

def read_pid() -> int | None:
    try:
        pid = int(PIDFILE.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return None


def cmd_run(args: argparse.Namespace) -> int:
    cfg = load_config(args)
    if not cure_hidden_theme(cfg):
        log(f"WARNING: could not confirm {cfg.normal_theme!r} is live before starting")
    stop = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())
    PIDFILE.write_text(str(os.getpid()))
    try:
        run_loop(cfg, stop)
    finally:
        PIDFILE.unlink(missing_ok=True)
    return 0


def cmd_start(args: argparse.Namespace) -> int:
    if read_pid():
        log(f"already running (pid {read_pid()})")
        return 0
    cmd = [sys.executable, os.path.abspath(__file__), "run"]
    if args.idle is not None:
        cmd += ["--idle", str(args.idle)]
    logf = open(RUNTIME_DIR / "mouse-hider.log", "ab")
    p = subprocess.Popen(cmd, stdout=logf, stderr=logf, stdin=subprocess.DEVNULL, start_new_session=True)
    log(f"started (pid {p.pid})")
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    """Kill the hider and make the pointer visible and working."""
    pid = read_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(40):
            if read_pid() is None:
                break
            time.sleep(0.25)
        else:
            os.kill(pid, signal.SIGKILL)
    return cmd_restore(args)


def cmd_restore(args: argparse.Namespace) -> int:
    cfg = load_config(args)
    if make_visible(cfg):
        log(f"cursor visible ({EFFECT} effect unloaded)")
        return 0
    log(f"ERROR: {EFFECT} effect loaded={effect_loaded()}, live cursor theme {live_theme()!r}")
    return 1


def cmd_probe(args: argparse.Namespace) -> int:
    """Print pointer-class events per device (read-only, no grab): who reveals the pointer?"""
    cfg = load_config(args)
    seconds = args.seconds if args.seconds is not None else 30.0
    log(f"probing for {seconds:g}s: touch the controller, then the mouse")
    devices = [d for d in open_devices() if is_pointer_device(d.capabilities()) or is_controller_input_node(d.info.vendor, d.capabilities(), cfg.controller_vendors)]
    for d in devices:
        kind = "controller input node (would be grabbed)" if is_controller_input_node(d.info.vendor, d.capabilities(), cfg.controller_vendors) else "pointer"
        print(f"  {d.path} {d.name!r} vendor={d.info.vendor:04x} {kind}")
    counts: dict[str, int] = {}
    deadline = time.monotonic() + seconds
    while devices and (left := deadline - time.monotonic()) > 0:
        ready, _, _ = select.select(devices, [], [], min(left, 0.5))
        for dev in ready:
            try:
                for ev in dev.read():
                    if ev.type in (EV_REL, EV_ABS, EV_KEY):
                        what = describe_event(dev, ev)
                        counts[what] = counts.get(what, 0) + 1
                        if counts[what] == 1:
                            print(f"  event: {what} (reveals pointer: {is_pointer_activity(ev.type, ev.code)})", flush=True)
            except OSError:
                devices.remove(dev)
    print(f"  {sum(counts.values())} events from {len(counts)} sources")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    pid = read_pid()
    print(f"hider: {'running pid ' + str(pid) if pid else 'not running'}")
    print(f"{EFFECT} effect loaded: {effect_loaded()}")
    print(f"live cursor theme: {live_theme()}")
    return 0 if pid else 3


def main() -> int:
    ap = argparse.ArgumentParser(prog="mouse-hider", description=__doc__.split("\n\n")[0])
    ap.add_argument("command", choices=["start", "stop", "restore", "status", "run", "probe"])
    ap.add_argument("seconds", nargs="?", type=float, help="probe: how long to listen (default 30)")
    ap.add_argument("--idle", type=float, help="idle seconds before hiding (default 15)")
    args = ap.parse_args()
    commands = {"start": cmd_start, "stop": cmd_stop, "restore": cmd_restore, "status": cmd_status, "run": cmd_run, "probe": cmd_probe}
    return commands[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
